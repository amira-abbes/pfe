    {
      "parameters": {
        "jsCode": "const summary = $('Recuperer synthese Bad Debts').first().json;\nconst reportResponse = $('Recuperer rapport agent IA').first().json;\nconst clientsResponse = $('Recuperer clients a risque').first().json;\n\nconst report = Array.isArray(reportResponse) ? reportResponse[0] : reportResponse;\nconst clients = clientsResponse.items || [];\nconst byTier = summary.by_tier || {};\nconst latestImport = summary.latest_import || {};\n\nconst totalClients = summary.total_clients_scored ?? summary.total_clients ?? 0;\nconst atRiskCount = summary.at_risk_count ?? 0;\nconst highRisk = byTier.high ?? summary.high_risk_count ?? 0;\nconst mediumRisk = byTier.medium ?? summary.medium_risk_count ?? 0;\nconst lowRisk = byTier.low ?? summary.low_risk_count ?? 0;\nconst anomalies = summary.anomaly_count ?? 0;\nconst avgScore = summary.avg_final_risk_score ?? summary.average_score ?? null;\nconst today = summary.date || new Date().toISOString().slice(0, 10);\nconst dashboardUrl = $env.PFE_DASHBOARD_URL || 'http://localhost:5173/dashboard/bad-debts';\n\nconst formatNumber = (value) => value === null || value === undefined ? '-' : new Intl.NumberFormat('fr-FR').format(value);\nconst formatScore = (value) => value === null || value === undefined ? '-' : Number(value).toFixed(3);\nconst escapeHtml = (value) => String(value ?? '-').replace(/[&<>\"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[char]));\n\nconst clientRows = clients.map((client) => `\n<tr>\n  <td style=\"padding:9px;border-bottom:1px solid #e5e7eb;\">${escapeHtml(client.msisdn)}</td>\n  <td style=\"padding:9px;border-bottom:1px solid #e5e7eb;\">${escapeHtml(client.segment || client.cluster_name)}</td>\n  <td style=\"padding:9px;border-bottom:1px solid #e5e7eb;\">${escapeHtml(client.risk_label || client.risk_tier)}</td>\n  <td style=\"padding:9px;border-bottom:1px solid #e5e7eb;text-align:right;\">${formatScore(client.final_risk_score)}</td>\n  <td style=\"padding:9px;border-bottom:1px solid #e5e7eb;text-align:right;\">${formatNumber(client.total_outstanding_amount)}</td>\n</tr>`).join('');\n\nconst html = `\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f6fb;margin:0;padding:24px;font-family:Arial,Helvetica,sans-serif;color:#111827;\">\n  <tr>\n    <td align=\"center\">\n      <table role=\"presentation\" width=\"760\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:100%;background:#ffffff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden;\">\n        <tr>\n          <td style=\"background:#123a8c;color:#ffffff;padding:24px 28px;\">\n            <h1 style=\"margin:0;font-size:24px;line-height:31px;\">Rapport automatique Bad Debts</h1>\n            <p style=\"margin:8px 0 0 0;font-size:14px;opacity:.92;\">Service SOS Solde & Data - ${escapeHtml(today)}</p>\n          </td>\n        </tr>\n        <tr>\n          <td style=\"padding:24px 28px;\">\n            <p style=\"margin:0 0 18px 0;font-size:15px;line-height:23px;\">\n              Ce rapport est genere automatiquement par n8n a partir des donnees ML disponibles dans PostgreSQL via les API FastAPI. Il n'est pas statique : les chiffres changent apres chaque import ou recalcul des scores.\n            </p>\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 18px 0;\">\n              <tr>\n                <td style=\"padding:10px;background:#eff6ff;border:1px solid #bfdbfe;\"><strong>Clients scores</strong><br>${formatNumber(totalClients)}</td>\n                <td style=\"padding:10px;background:#fff7ed;border:1px solid #fed7aa;\"><strong>Clients a risque</strong><br>${formatNumber(atRiskCount)}</td>\n                <td style=\"padding:10px;background:#fdf2f8;border:1px solid #fbcfe8;\"><strong>Risque eleve</strong><br>${formatNumber(highRisk)}</td>\n                <td style=\"padding:10px;background:#f5f3ff;border:1px solid #ddd6fe;\"><strong>Anomalies</strong><br>${formatNumber(anomalies)}</td>\n              </tr>\n            </table>\n            <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 20px 0;border-collapse:collapse;\">\n              <tr><td style=\"padding:8px;border-bottom:1px solid #e5e7eb;\"><strong>Risque faible</strong></td><td style=\"padding:8px;border-bottom:1px solid #e5e7eb;text-align:right;\">${formatNumber(lowRisk)}</td></tr>\n              <tr><td style=\"padding:8px;border-bottom:1px solid #e5e7eb;\"><strong>Risque moyen</strong></td><td style=\"padding:8px;border-bottom:1px solid #e5e7eb;text-align:right;\">${formatNumber(mediumRisk)}</td></tr>\n              <tr><td style=\"padding:8px;border-bottom:1px solid #e5e7eb;\"><strong>Score moyen</strong></td><td style=\"padding:8px;border-bottom:1px solid #e5e7eb;text-align:right;\">${formatScore(avgScore)}</td></tr>\n              <tr><td style=\"padding:8px;border-bottom:1px solid #e5e7eb;\"><strong>Dernier import</strong></td><td style=\"padding:8px;border-bottom:1px solid #e5e7eb;text-align:right;\">${escapeHtml(latestImport.nom_fichier || latestImport.filename || latestImport.id || '-')}</td></tr>\n            </table>\n            <h2 style=\"margin:0 0 10px 0;font-size:18px;\">Synthese IA</h2>\n            <p style=\"margin:0 0 8px 0;font-size:14px;line-height:22px;\">${escapeHtml(report?.summary || 'Aucune synthese disponible.')}</p>\n            <p style=\"margin:0 0 22px 0;font-size:14px;line-height:22px;\"><strong>Recommandations :</strong> ${escapeHtml(report?.recommendations || 'Aucune recommandation disponible.')}</p>\n            <h2 style=\"margin:0 0 10px 0;font-size:18px;\">Top clients a risque eleve</h2>\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:13px;\">\n              <thead>\n                <tr style=\"background:#f9fafb;\">\n                  <th align=\"left\" style=\"padding:9px;border-bottom:1px solid #d1d5db;\">MSISDN</th>\n                  <th align=\"left\" style=\"padding:9px;border-bottom:1px solid #d1d5db;\">Segment</th>\n                  <th align=\"left\" style=\"padding:9px;border-bottom:1px solid #d1d5db;\">Risque</th>\n                  <th align=\"right\" style=\"padding:9px;border-bottom:1px solid #d1d5db;\">Score</th>\n                  <th align=\"right\" style=\"padding:9px;border-bottom:1px solid #d1d5db;\">Impayes</th>\n                </tr>\n              </thead>\n              <tbody>${clientRows || '<tr><td colspan=\"5\" style=\"padding:12px;text-align:center;\">Aucun client a risque eleve retourne par l API.</td></tr>'}</tbody>\n            </table>\n            <p style=\"margin:24px 0 0 0;text-align:center;\">\n              <a href=\"${dashboardUrl}\" style=\"display:inline-block;background:#2563eb;color:#ffffff;text-decoration:none;font-weight:bold;border-radius:999px;padding:12px 22px;\">Ouvrir le dashboard Bad Debts</a>\n            </p>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>`;\n\nreturn [{\n  json: {\n    date: today,\n    subject: `Rapport Bad Debts - ${today} - ${formatNumber(highRisk)} clients risque eleve`,\n    html_body: html,\n    kpis: { totalClients, atRiskCount, highRisk, mediumRisk, lowRisk, anomalies, avgScore },\n    clients_count: clients.length,\n    source_latest_import: latestImport\n  }\n}];"
      },
